# ============================================================
# CONVIVO BFF - Variables de entorno
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA commitees `.env` ni credenciales reales.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
# Lista de origenes permitidos para CORS, separados por coma.
# En producción usar origenes explícitos, nunca '*'.
CORS_ORIGINS=http://localhost:4200
# Prefijo global de rutas (ver main.ts)
GLOBAL_PREFIX=api

# --- Configuración de la app ---
# Nombre del servicio para logs y health checks.
SERVICE_NAME=convivo-bff

# --- Microsoft Entra ID (validación de JWT) ---
ENTRA_TENANT_ID=REEMPLAZAR_CON_TENANT_ID
# Client ID de la API de CONVIVO registrada en Entra ID.
ENTRA_API_CLIENT_ID=528af346-c37c-40a0-9f7e-30162de3c027
# Issuer estricto del tenant (se construye con ENTRA_TENANT_ID si no se define).
# ENTRA_ISSUER=https://login.microsoftonline.com/REEMPLAZAR_CON_TENANT_ID/v2.0
# URL de descubrimiento de claves públicas (JWKS) de Entra.
# ENTRA_JWKS_URI=https://login.microsoftonline.com/REEMPLAZAR_CON_TENANT_ID/discovery/v2.0/keys

# --- Authorization / Roles ---
# Claim del que se leen los roles del usuario en el JWT.
# Todavía NO está definido: configurar cuando se definan los App Roles en Entra.
CLAIM_DE_ROL=roles
# Separador si el claim es una lista (ej. roles="admin,user")
CLAIM_SEPARADOR=,
# Mapeo valor-del-claim -> rol de negocio del BFF. Formato: valor=rol,...
# Ejemplo: CLAIM_MAPEO=admin=administrador,portero=conserje
CLAIM_MAPEO=

# --- Microservicios ---
# URL base del microservicio Gastos Comunes (Java/Spring Boot/Oracle).
GASTOS_COMUNES_URL=http://localhost:8081
# Timeout (ms) para las llamadas del BFF hacia los microservicios.
PROXY_TIMEOUT_MS=10000

# --- RabbitMQ / Amazon MQ (PREPARADO, sin conexión en esta etapa) ---
# Mantener RABBITMQ_ENABLED=false hasta implementar la conexión real.
RABBITMQ_ENABLED=false
# URLs de brokers (Amazon MQ). No usar credenciales aquí.
# RABBITMQ_URLS=amqp://localhost:5672
# Nombre del exchange/cola base.
RABBITMQ_EXCHANGE=convivo
